{
  "name": "@bluff/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rimraf ./fhevmTemp ./artifacts ./cache ./coverage ./types ./coverage.json",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "lint": "pnpm lint:sol && pnpm lint:ts",
    "lint:sol": "solhint --max-warnings 0 --disc --noPoster \"contracts/**/*.sol\"",
    "lint:ts": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test",
    "test:sepolia": "hardhat test --network sepolia",
    "coverage": "cross-env SOLIDITY_COVERAGE=true hardhat coverage",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "coverage:check": "node scripts/check-coverage.mjs",
    "deploy:local": "hardhat deploy --network localhost",
    "upgrade:sepolia": "hardhat upgrade --network sepolia",
    "slither": "./scripts/slither.sh"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "5.7.0",
    "@openzeppelin/contracts-upgradeable": "5.7.0",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@openzeppelin/hardhat-upgrades": "3.9.1",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "4.5.0",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "ethers": "6.17.0",
    "globals": "17.14.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "2.3.0",
    "rimraf": "6.1.4",
    "solhint": "6.2.5",
    "solidity-coverage": "0.8.17",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}

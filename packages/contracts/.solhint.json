{
  "extends": "solhint:recommended",
  "rules": {
    "code-complexity": ["error", 8],
    "compiler-version": ["error", ">=0.8.24"],
    "func-visibility": ["error", { "ignoreConstructors": true }],
    "max-line-length": ["error", 120],
    "named-parameters-mapping": "error",
    "custom-errors": "error",
    "use-natspec": "off",
    "no-console": "error",
    "not-rely-on-time": "off"
  }
}

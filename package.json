{
  "name": "bluff",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @bluff/web dev",
    "build": "pnpm --filter @bluff/web build",
    "compile": "pnpm --filter @bluff/contracts compile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "knip": "knip",
    "comments:check": "node scripts/check-comments.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "preflight": "./scripts/preflight.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-solidity": "2.4.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  }
}

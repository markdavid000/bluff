{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "*.mjs", "*.mts"],
  "exclude": ["node_modules", "dist"]
}

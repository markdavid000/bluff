{
  "name": "@bluff/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:cloudflare": "opennextjs-cloudflare build",
    "smoke:worker": "./scripts/worker-smoke.sh",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.158.0"
  }
}
